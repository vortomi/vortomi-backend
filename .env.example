# Copy to .env and fill in. Never commit .env; never paste these values in chats.

# --- Server -----------------------------------------------------------------
NODE_ENV=development
# 127.0.0.1 on your computer (not reachable from the network); 0.0.0.0 in a container.
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info

# --- Database (Supabase) ----------------------------------------------------
# Supabase dashboard -> Connect -> Connection string. Use the "Direct connection"
# (IPv6) or, on an IPv4-only network, the "Session pooler" (port 5432). Not the
# transaction pooler (6543): tenant scoping uses SET LOCAL inside transactions.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_POOL_MAX=5

# --- Supabase Auth -----------------------------------------------------------
# Not a secret. Supabase dashboard -> Project Settings -> API -> Project URL.
# The project must sign tokens with asymmetric keys (Authentication -> JWT Keys).
SUPABASE_URL=https://PROJECT_REF.supabase.co

# --- Meta (platform-wide: one app, one webhook for every company) ----------
# SECRET. Meta App Dashboard -> App settings -> Basic -> App secret.
META_APP_SECRET=
# SECRET you invent (24+ random characters). Type the same value in Meta when
# subscribing the webhook. Example: openssl rand -hex 24
WEBHOOK_VERIFY_TOKEN=

# SECRET. Encrypts each number's access token in the database. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=
GRAPH_API_VERSION=v26.0

# Numbers are not configured here: each one belongs to a company in the
# database. Register ours with: npm run channel:register -- --help
