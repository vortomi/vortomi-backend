{
  "name": "vortomi-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Vortomi backend: multi-company WhatsApp CRM.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "channel:register": "tsx scripts/register-channel.ts",
    "member:add": "tsx scripts/add-member.ts",
    "channel:set-token": "tsx scripts/set-channel-token.ts",
    "meta:simulate": "tsx scripts/simulate-webhook.ts",
    "db:seed-sample": "tsx scripts/seed-sample-data.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
